[Desktop Entry]
Name=Neovim
GenericName=Text Editor
Comment=Edit text files
Exec=kitty -e nvim %F
Terminal=false
Type=Application
Icon=nvim
Categories=Utility;TextEditor;
StartupNotify=false
MimeType=text/plain;text/english;text/x-makefile;text/x-c;text/x-c++;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-java;application/x-shellscript;
