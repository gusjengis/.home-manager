{
  "layer": "bottom",
  "exclusive": false,
  "position": "top",
  "height": 42,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/media"
  ],
  "modules-right": [
    "custom/wifi",
    "custom/bluetooth",
    "custom/clock",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true,
    "show-special": true
  },

  "custom/media": {
    "exec": "bash ~/.home-manager/config_files/hypr/scripts/current-media.sh",
    "return-type": "json",
    "interval": 1,
    "max-length": 80,
    "on-click": "bash ~/.home-manager/config_files/hypr/scripts/open-media-source.sh",
    "on-click-middle": "bash ~/.home-manager/config_files/hypr/scripts/media-menu.sh",
    "on-click-right": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "custom/bluetooth": {
    "exec": "bash ~/.home-manager/config_files/hypr/scripts/waybar-bluetooth.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "bash ~/.home-manager/config_files/hypr/scripts/open-bluetooth-manager.sh",
    "tooltip": true
  },

  "custom/wifi": {
    "exec": "bash ~/.home-manager/config_files/hypr/scripts/waybar-wifi.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "bash ~/.home-manager/config_files/hypr/scripts/open-network-manager.sh",
    "tooltip": true
  },

  "custom/clock": {
    "exec": "bash ~/.home-manager/config_files/hypr/scripts/waybar-clock.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": true
  },

  "tray": {
    "spacing": 10
  }
}
